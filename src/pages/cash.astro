---
import AutoAddress from "@/components/AutoAddress.astro";
import BeforeAfter from "@/components/BeforeAfter.astro";
import ConditionsSection from "@/components/ConditionsSection.astro";
import FAQ from "@/components/FAQ.astro";
import MetricsSection from "@/components/MetricsSection.astro";

import SeoPage from "@/components/SeoPage.astro";

import StepsSection from "@/components/StepsSection.astro";
import TestimonialSection from "@/components/TestimonialSection.astro";
import ValueBar from "@/components/ValueBar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <SeoPage slot="head" />
  <section class="pt-16 pb-24">
    <h1 class="h1 text-center">Tell us about your property</h1>
    <p class="text-center text-pretty mt-4">
      Enter your street address below to start your written, no-obligation offer."
    </p>

    <div class="mt-8">
      <!-- <OfferForm /> -->
      <AutoAddress />
    </div>
  </section>

  <ValueBar />

  <section class="colored-stripe pt-16 pb-24">
    <ConditionsSection />
  </section>

  <section class="feature pt-16 pb-24">
    <MetricsSection />
  </section>
  <section class="feature pt-16">
    <BeforeAfter />
  </section>
  <section class="feature pt-16 pb-24">
    <StepsSection />
  </section>
  <section class="feature pt-16 pb-24">
    <TestimonialSection />
  </section>
  <section class="feature pt-16 pb-24">
    <FAQ />
  </section>
</BaseLayout>
