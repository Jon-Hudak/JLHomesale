---

import FAQ from "@/components/FAQ.astro";
import OfferForm from "@/components/OfferForm.astro";
import SeoPage from "@/components/SeoPage.astro";
import StepsSection from "@/components/StepsSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout contentSpace="65">
    <SeoPage slot="head" />
  <section class="py-16 feature">
    <h1 class="h1 text-center">Steps to sell</h1>
    <StepsSection />
  </section>
  <section class="pb-24">
    <div class="max-w-2xl mx-auto">
      <OfferForm />
    </div>
    <div class="flow mt-8">
      <h3 class="h3">How we build the number</h3>
      <p>
        Our offer starts with what comparable renovated homes in your
        neighborhood have sold for in the last several months. From there we
        subtract the work the property needs, the carrying and closing costs we
        take on, and our margin. We walk you through each line so you can decide
        whether an off-market sale or a traditional listing makes more sense for
        you.
      </p>
      <h3 class="h3">What you'll need</h3>
      <ul class="list-disc pl-6">
        <li>The property address and who is on title</li>
        <li>A rough sense of condition — photos help but aren't required</li>
        <li>A rough sense of condition — photos help but aren't required</li>
        <li>Your preferred closing window</li>
      </ul>
      <h3 class="h3">At closing</h3>
      <p>
        A licensed title company or real estate attorney handles the title
        search, payoff of any existing mortgage, and disbursement of your
        proceeds by wire or check. Standard closing costs are covered by us on
        most transactions, and there is no agent commission on our purchase.
      </p>
    </div>
  </section>
  <section class="colored-stripe pt-16 pb-24">
    <h2 class="h2 text-center content">What goes into our offer?</h2>
    <p class="text-center text-pretty mt-4">
      Every offer is based on your home's real market value and condition — and
      we show you each line.
    </p>

    <div
      class="feature mt-8 flex flex-wrap items-center justify-center gap-3 text-sm font-medium text-slate-800 sm:text-base"
    >
      <div
        class="flex h-14 items-center justify-center rounded-xl bg-lightSecAccent px-6 text-black font-bold shadow-sm"
      >
        Your offer
      </div>

      <span class="text-xl font-normal text-slate-400" aria-hidden="true"
        >=</span
      >

      <div
        class="flex h-14 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 shadow-xs"
      >
        After repair value
      </div>

      <span class="text-xl font-normal text-slate-400" aria-hidden="true"
        >&minus;</span
      >

      <div
        class="flex h-14 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 shadow-xs"
      >
        Repair costs
      </div>

      <span class="text-xl font-normal text-slate-400" aria-hidden="true"
        >&minus;</span
      >

      <div
        class="flex h-14 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 shadow-xs"
      >
        Selling costs
      </div>

      <span class="text-xl font-normal text-slate-400" aria-hidden="true"
        >&minus;</span
      >

      <div
        class="flex h-14 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 shadow-xs"
      >
        Profit margin
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="h2">Listing with an agent vs. selling to us</h2>
      <p class="mt-4">
        A listing often nets a higher sale price. An off-market sale gives you a
        target date and no out-of-pocket prep. Here is the honest comparison:
      </p>
    </div>

    <!-- ========================================== -->
    <!-- MOBILE VIEW: Stacked Cards (Hidden on md+) -->
    <!-- ========================================== -->
    <div class="space-y-6 md:hidden mt-8">
      <!-- Card 1 -->
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3
          class="border-b border-slate-100 pb-3 text-lg font-bold text-slate-900"
        >
          Repairs and cleaning
        </h3>
        <div class="mt-3 grid grid-cols-2 gap-4">
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wider text-slate-500"
            >
              Traditional
            </p>
            <p class="mt-1 text-sm text-slate-600">
              Typically expected before photos
            </p>
          </div>
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wider text-slate-900"
            >
              JL Home Sale
            </p>
            <p class="mt-1 text-sm font-medium text-slate-900">
              Reviewed as-is
            </p>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3
          class="border-b border-slate-100 pb-3 text-lg font-bold text-slate-900"
        >
          Showings and open houses
        </h3>
        <div class="mt-3 grid grid-cols-2 gap-4">
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wider text-slate-500"
            >
              Traditional
            </p>
            <p class="mt-1 text-sm text-slate-600">Ongoing for weeks</p>
          </div>
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wider text-slate-900"
            >
              JL Home Sale
            </p>
            <p class="mt-1 text-sm font-medium text-slate-900">None</p>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3
          class="border-b border-slate-100 pb-3 text-lg font-bold text-slate-900"
        >
          Agent commission
        </h3>
        <div class="mt-3 grid grid-cols-2 gap-4">
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wider text-slate-500"
            >
              Traditional
            </p>
            <p class="mt-1 text-sm text-slate-600">Typically 5-6%</p>
          </div>
          <div>
            <p
              class="text-xs font-semibold uppercase tracking-wider text-slate-900"
            >
              JL Home Sale
            </p>
            <p class="mt-1 text-sm font-medium text-slate-900">
              None on our purchase
            </p>
          </div>
        </div>
      </div>

      <!-- You can continue the pattern for the remaining 3 items here -->
    </div>

    <!-- ========================================== -->
    <!-- DESKTOP VIEW: Standard Table (Hidden on sm)-->
    <!-- ========================================== -->
    <div
      class="mt-8 hidden overflow-hidden rounded-xl border border-slate-200 shadow-sm md:block"
    >
      <table class="w-full text-left text-base">
        <thead class="bg-[#243545] text-white">
          <tr>
            <th scope="col" class="w-1/3 px-6 py-5 font-semibold"></th>
            <th scope="col" class="w-1/3 px-6 py-5 font-semibold"
              >Traditional listing</th
            >
            <th scope="col" class="w-1/3 px-6 py-5 font-semibold"
              >JL Home Sale</th
            >
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <tr>
            <th
              scope="row"
              class="px-6 py-5 font-medium text-slate-900 whitespace-nowrap"
              >Repairs and cleaning</th
            >
            <td class="px-6 py-5 text-slate-500"
              >Typically expected before photos</td
            >
            <td class="px-6 py-5 font-medium text-slate-900">Reviewed as-is</td>
          </tr>
          <tr>
            <th
              scope="row"
              class="px-6 py-5 font-medium text-slate-900 whitespace-nowrap"
              >Showings and open houses</th
            >
            <td class="px-6 py-5 text-slate-500">Ongoing for weeks</td>
            <td class="px-6 py-5 font-medium text-slate-900">None</td>
          </tr>
          <tr>
            <th
              scope="row"
              class="px-6 py-5 font-medium text-slate-900 whitespace-nowrap"
              >Agent commission</th
            >
            <td class="px-6 py-5 text-slate-500">Typically 5-6%</td>
            <td class="px-6 py-5 font-medium text-slate-900"
              >None on our purchase</td
            >
          </tr>
          <!-- Continue remaining desktop rows -->
        </tbody>
      </table>
    </div>
  </section>

  <section
    class="place-self-center w-full max-w-4xl px-4 pb-24 sm:px-6 lg:px-8"
    aria-labelledby="faq-heading"
  >
    <FAQ />
  </section>

  <section class="colored-stripe pt-16 pb-24">
    <h2 class="h2">See what your home could sell for</h2>
    <p mt-4>
      Enter the property address to get started. A specialist reviews your
      property and follows up with a written offer — no obligation to accept.
    </p>
    <div class="mt-8">
      <OfferForm />
      <small class="block text-center mt-2">
        No obligation. Homes reviewed as-is.
      </small>
    </div>
  </section>
</BaseLayout>
