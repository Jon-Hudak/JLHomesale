---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SeoPage from "@/components/SeoPage.astro";
import OfferForm from "@/components/OfferForm.astro";
import { Image } from "astro:assets";
import FeatureCard from "@/components/FeatureCard.astro";
import Button from "@/components/Button.astro";

import { situations, contactFeatures } from "@/data/homeContent";
import FAQ from "@/components/FAQ.astro";
import BeforeAfter from "@/components/BeforeAfter.astro";
import MetricsSection from "@/components/MetricsSection.astro";
import TestimonialSection from "@/components/TestimonialSection.astro";
import ValueBar from "@/components/ValueBar.astro";
import FeaturesSection from "@/components/FeaturesSection.astro";

import heroImg from "@/assets/images/hero-home.jpg";
import AutoAddress from "@/components/AutoAddress.astro";
import { Picture } from "astro:assets";
---

<BaseLayout>
  <SeoPage slot="head" />

  <section
    class="feature mx-8 xl:mx64 grid lg:grid-cols-2 lg:breakout-right gap-x-8 gap-y-4 mt-12 pb-16"
  >
    <div class="">
      <p class="uppercase eyebrow">Helping Homeowners Nationwide</p>
      <h1 class="font-bold mt-4 text-3xl text-pretty">
        Selling your home has never been easier
      </h1>

      <p class="mt-4 text-lg text-pretty">
        Sell your property as-is, with no commissions. Enter your address below
        to get your offer.
      </p>

      <div class="mt-8">
        <AutoAddress />
        <!-- <OfferForm /> -->
        <ul
          class="mt-6 gap-2 grid grid-cols-2 h-full content-end justify-between"
        >
          <li class="flex gap-2 place-items-center">
            <span class=""
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-circle-check size-4 shrink-0 text-accent stroke-secAccent"
                aria-hidden="true"
                data-tsd-source="/src/routes/index.tsx:68:19"
                ><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"
                ></path></svg
              ></span
            >Written Offer
          </li>
          <li class="flex gap-2 place-items-center">
            <span class=""
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-circle-check size-4 shrink-0 text-accent stroke-secAccent"
                aria-hidden="true"
                data-tsd-source="/src/routes/index.tsx:68:19"
                ><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"
                ></path></svg
              ></span
            >As-is condition
          </li>
          <li class="flex gap-2 place-items-center">
            <span class=""
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-circle-check size-4 shrink-0 text-accent stroke-secAccent"
                aria-hidden="true"
                data-tsd-source="/src/routes/index.tsx:68:19"
                ><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"
                ></path></svg
              ></span
            >No agent commissions
          </li>
          <li class="flex gap-2 place-items-center">
            <span class=""
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-circle-check size-4 shrink-0 text-accent stroke-secAccent"
                aria-hidden="true"
                data-tsd-source="/src/routes/index.tsx:68:19"
                ><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"
                ></path></svg
              ></span
            >Pick your close date
          </li>
        </ul>
      </div>
    </div>
    <div class="relative grid self-end">
     

      <div
        class="hero-photo-shape h-[500px] sm:h-[590px] place-self-end relative"
      >
        <Picture
          src={heroImg}
          alt="Two story house at sunset"
          formats={["avif", "webp"]}
          widths={[400, 800, 1200]}
          sizes="(max-width: 640px) 400px, 800px"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="object-cover size-full mt-auto rounded-b-4xl"
        />
      </div>
      <div
        class="bg-white absolute left-2 top-28 flex items-center gap-3 rounded-full bg-card px-4 py-3 shadow-lift sm:-left-8"
        data-tsd-source="/src/routes/index.tsx:78:13"
      >
        <span
          class="flex size-12 items-center justify-center rounded-full bg-accent text-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-shield-check size-6"
            aria-hidden="true"
          >
            <path
              d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"
            ></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </span>
        <span
          class="text-xs leading-4"
          data-tsd-source="/src/routes/index.tsx:80:15"
        >
          <strong
            class="block font-black"
            data-tsd-source="/src/routes/index.tsx:80:51"
            >As-is condition
          </strong>Reviewed as it sits
        </span>
      </div>
    </div>
  </section>
  <ValueBar />
  <section class="colored-stripe full py-24">
    <div class="feature">
      <MetricsSection />
    </div>
  </section>

  <section class="feature pt-12 pb-24">
    <TestimonialSection />
  </section>
  <section class="feature pb-24">
    <BeforeAfter />
  </section>
  <section class="colored-stripe pt-16 pb-24">
    <FeaturesSection />
  </section>
  <section class="feature pt-16 pb-24">
    <p class="eyebrow text-center">Situations We Help With</p>
    <h2 class="h2 mt-2 text-center">Every property has a story</h2>
    <p class="mt-2 text-center max-w-[65ch] mx-auto text-pretty">
      Most homeowners who contact us aren't in a rush to move — they just want a
      straightforward path that doesn't involve contractors and open houses.
    </p>
    <ul class="grid md:grid-cols-3 gap-6 mt-8 text-pretty">
      {
        situations.map((s) => (
          <FeatureCard title={s.title} description={s.description} />
        ))
      }
    </ul>
    <div>
      <a href="/situations" class="a text-center mt-4 block"
        >Read more about each situation</a
      >
    </div>
  </section>

  <section
    class="feature place-self-center w-full max-w-4xl px-4 pb-16 sm:px-6 lg:px-8"
    aria-labelledby="faq-heading"
  >
    <FAQ />
  </section>
  <section class="feature pt-16 pb-24">
    <h2 class="h2 mt-2 text-center">We aim to make selling stress-free</h2>
    <p class="mt-4 text-center max-w-[65ch] mx-auto">
      Your satisfaction is our priority. Reach out today and we'll walk you
      through your options — no pressure, no obligation.
    </p>

    <ul class="grid md:grid-cols-3 gap-6 mt-8">
      {
        contactFeatures.map((s) => (
          <FeatureCard
            title={s.title}
            description={s.description}
            icon={s.icon}
          />
        ))
      }
    </ul>
  </section>
  <section class="colored-stripe pt-16 pb-24">
    <h2 class="h2 text-center">See what your home could sell for</h2>
    <p class="text-center max-w-[65ch] mx-auto mt-4">
      Enter the property address to get started. A specialist reviews your
      property and follows up with a written offer — no obligation to accept.
    </p>
    <div class="xl:mx-48 mt-8 feature">
      <AutoAddress />

      <small class="text-center block"
        >No obligation. Homes reviewed as-is.</small
      >
    </div>
  </section>
</BaseLayout>
<style>
  .hero-photo-shape {
    clip-path: polygon(19% 0, 100% 12%, 100% 100%, 0 100%, 0 29%);
    border-radius: 1.75rem;
  }
</style>
