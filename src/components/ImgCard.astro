---
interface Props {
  as?: any; // Allows passing 'li', 'article', 'div', etc.
  class?: string;
}

const { as: Tag = "div", class: className = "" } = Astro.props;
---

<Tag
  class={`rounded-lg border border-neutral-300 bg-white shadow-sm ${className} overflow-hidden h-full`}
>
  <slot />
</Tag>


