---
import Card from "@/components/Card.astro";
---

    <h2 class="h2 mt-16 text-center">The process</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6 feature">
      <Card
        ><span class="text-4xl font-bold">1</span>
        <h3>Share your property details</h3>
        <p>
          Fill out our quick online form or give us a call with a few basic
          details about your property.
        </p>
      </Card>
      <Card
        ><span class="text-4xl font-bold">2</span>
        <h3>Get your fair written offer</h3>
        <p>
          We review your property's current condition and market value, then
          present a fair written offer — usually within 24 hours.
        </p>
      </Card>
      <Card
        ><span class="text-4xl font-bold">3</span>
        <h3>Choose your closing date</h3>
        <p>
          If you accept, we handle the paperwork and work toward the closing
          date you choose.
        </p>
      </Card>
    </div>