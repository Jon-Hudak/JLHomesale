---
import Button from "@/components/Button.astro";
---

<form
  id="offerForm"
  novalidate
  class="p-6 border-2 border-lightSecAccent rounded-xl grid md:grid-cols-2 gap-2 bg-neutral-100"
>
  <!-- BOT TRAP 1: Honeypot (Hidden from humans, visible to bots) -->
  <div class="bot-field" aria-hidden="true">
    <label for="company_website">Do not fill this out if you are human</label>
    <input
      type="text"
      name="company_website"
      id="company_website"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <!-- Property Address -->
  <div class="form-group col-span-2">
    <label for="propertyAddress"
      >Property Address <span aria-hidden="true">*</span></label
    >
    <input
      type="text"
      id="propertyAddress"
      name="propertyAddress"
      required
      autocomplete="street-address"
      placeholder="123 Main St, City, State, Zip"
    />
    <div id="addressError" class="error-message" aria-live="polite">
      Please enter your property address.
    </div>
  </div>

  <!-- Phone Number -->
  <div class="form-group mt-4 col-span-2 md:col-span-1">
    <label for="phoneNumber"
      >Phone Number <span aria-hidden="true">*</span></label
    >
    <input
      type="tel"
      id="phoneNumber"
      name="phoneNumber"
      required
      maxlength="14"
      autocomplete="tel"
      placeholder="(555) 555-5555"
    />
    <div id="phoneError" class="error-message" aria-live="polite">
      Please enter a valid 10-digit phone number.
    </div>
  </div>

  <!-- Email Address -->
  <div class="form-group mt-4 col-span-2 md:col-span-1">
    <label for="emailAddress"
      >Email Address <span aria-hidden="true">*</span></label
    >
    <input
      type="email"
      id="emailAddress"
      name="emailAddress"
      required
      autocomplete="email"
      placeholder="name@example.com"
    />
    <div id="emailError" class="error-message" aria-live="polite">
      Please enter a valid email address.
    </div>
  </div>

  <!-- Consent Checkbox & Disclosure -->
  <div class="checkbox-group col-span-2">
    <input type="checkbox" id="consentCheck" name="consentCheck" required />
    <label for="consentCheck">
      I agree to be contacted by phone, text, or email about my property,
      including by automated means. Consent is not a condition of any sale. See
      our <a class="a underline" href="/terms" target="_blank">Terms of Use</a> and
      <a class="a underline" href="/privacy" target="_blank">Privacy Policy</a>.
    </label>
  </div>
  <div
    id="consentError"
    class="error-message"
    aria-live="polite"
    style="margin-top: -0.75rem; margin-bottom: 1rem;"
  >
    You must agree to the terms to proceed.
  </div>

  <!-- Submit Button -->
  <div class="col-span-2 submit-wrapper">
    <Button class="button" type="submit" hasArrow={true} id="submitBtn">Get Offer</Button>
  </div>
</form>

<style>
  /* Completely conceal the bot honeypot from view, screen readers, and layout */
  .bot-field {
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    height: 0;
    width: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  input[type="text"],
  input[type="tel"],
  input[type="email"] {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1rem;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  input:focus {
    outline: none;
    border-color: #0056b3;
    box-shadow: 0 0 0 3px rgba(0, 86, 179, 0.15);
  }

  input.invalid {
    border-color: #d93025;
  }

  .error-message {
    color: #d93025;
    font-size: 0.85rem;
    margin-top: 0.35rem;
    display: none;
  }

  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 1rem 0;
  }

  .checkbox-group input[type="checkbox"] {
    appearance: auto;
    -webkit-appearance: checkbox;
    color-scheme: light;
    accent-color: var(--color-accent);
    margin-top: 0.25rem;
    width: 1.15rem;
    height: 1.15rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .checkbox-group label {
    font-weight: normal;
    font-size: 0.875rem;
    line-height: 1.4;
    color: #555;
    cursor: pointer;
  }
</style>

<script>
  function initForm() {
    const form = document.getElementById("offerForm") as HTMLFormElement;
    if (!form) return;

    
    const ZAPIER_ENDPOINT = "https://hooks.zapier.com/hooks/catch/9846372/4d8t1vf/";

    // BOT TRAP 2: Timestamp tracker
    const pageLoadTime = Date.now();

    const phoneInput = document.getElementById("phoneNumber") as HTMLInputElement;
    const phoneError = document.getElementById("phoneError") as HTMLElement;
    const addressInput = document.getElementById("propertyAddress") as HTMLInputElement;
    const addressError = document.getElementById("addressError") as HTMLElement;
    const emailInput = document.getElementById("emailAddress") as HTMLInputElement;
    const emailError = document.getElementById("emailError") as HTMLElement;
    const consentCheck = document.getElementById("consentCheck") as HTMLInputElement;
    const consentError = document.getElementById("consentError") as HTMLElement;
    const honeypot = document.getElementById("company_website") as HTMLInputElement;
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;

    // Auto-format phone number
    phoneInput?.addEventListener("input", (e) => {
      const target = e.target as HTMLInputElement;
      let digits = target.value.replace(/\D/g, "");
      if (digits.length > 10) digits = digits.substring(0, 10);

      let formatted = "";
      if (digits.length > 0) formatted = "(" + digits.substring(0, 3);
      if (digits.length >= 4) formatted += ") " + digits.substring(3, 6);
      if (digits.length >= 7) formatted += "-" + digits.substring(6, 10);
      target.value = formatted;
    });

    form.addEventListener("submit", async function (event) {
      event.preventDefault();

      // BOT CHECK 1: Honeypot field filled? Silent discard.
      if (honeypot && honeypot.value.trim() !== "") {
        console.warn("Form ignored.");
        return; 
      }

      // BOT CHECK 2: Submitted in under 2.5 seconds? Silent discard.
      const elapsedSeconds = (Date.now() - pageLoadTime) / 1000;
      if (elapsedSeconds < 2.5) {
        console.warn("Form ignored.");
        return;
      }

      let isValid = true;

      // 1. Validate Address
      if (!addressInput.value.trim()) {
        addressInput.classList.add("invalid");
        addressError.style.display = "block";
        isValid = false;
      } else {
        addressInput.classList.remove("invalid");
        addressError.style.display = "none";
      }

      // 2. 10-Digit Phone Validation
      const rawPhoneDigits = phoneInput.value.replace(/\D/g, "");
      if (rawPhoneDigits.length !== 10) {
        phoneInput.classList.add("invalid");
        phoneError.style.display = "block";
        isValid = false;
      } else {
        phoneInput.classList.remove("invalid");
        phoneError.style.display = "none";
      }

      // 3. Email Validation
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(emailInput.value.trim())) {
        emailInput.classList.add("invalid");
        emailError.style.display = "block";
        isValid = false;
      } else {
        emailInput.classList.remove("invalid");
        emailError.style.display = "none";
      }

      // 4. Consent Validation
      if (!consentCheck.checked) {
        consentError.style.display = "block";
        isValid = false;
      } else {
        consentError.style.display = "none";
      }

      // Final AJAX dispatch
      if (isValid) {
        // Update UI to show processing state
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Processing...";
          submitBtn.style.opacity = "0.7";
          submitBtn.style.cursor = "not-allowed";
        }

        try {
          const response = await fetch(ZAPIER_ENDPOINT, {
            method: "POST",
            body: JSON.stringify({
              propertyAddress: addressInput.value.trim(),
              phoneNumber: rawPhoneDigits, // Clean 10 digits
              formattedPhone: phoneInput.value,
              emailAddress: emailInput.value.trim(),
              consent: consentCheck.checked,
              submittedAt: new Date().toISOString(),
              sourceUrl: window.location.href,
            }),
          });

          if (!response.ok) throw new Error("Network response was not ok");

          // Render Success State directly into the form wrapper
          form.innerHTML = `
            <div class="col-span-2 text-center py-10">
              <div class="mx-auto w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-slate-800 mb-2">Offer Request Received!</h3>
              <p class="text-slate-600">We're reviewing your property details and will reach out shortly.</p>
            </div>
          `;
        } catch (error) {
          console.error("Submission error:", error);
          alert("There was an issue submitting your request. Please call us directly.");
          
          // Re-enable button if it fails
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Get Offer";
            submitBtn.style.opacity = "1";
            submitBtn.style.cursor = "pointer";
          }
        }
      }
    });
  }

  // Run on initial load and Astro View Transitions
  initForm();
  document.addEventListener("astro:page-load", initForm);
</script>