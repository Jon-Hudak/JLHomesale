---
import Button from "@/components/Button.astro";


---
<div class="grid lg:grid-cols-2 gap-16">
      <div class="">
        <p class="eyebrow">Trusted Home Buyers</p>
        <h2 class="h2 mt-2">
          Skip the stress and expense of listing with an agent
        </h2>
        <p class="mt-2">
          JL Home Sale offers a straightforward, off-market way to sell your
          house, putting you in control of the process. Here's why homeowners
          across the country work with us.
        </p>
        <Button as="a" href="/how" class="mt-4">See How It Works</Button>
      </div>
      <div class="grid place-items-center">
        <ul class="grid grid-cols-2 gap-8">
          <li class="pl-4 flex flex-col border-l-2 border-lightSecAccent">
            In closed transactions<span class="text-3xl">$38M+</span>
          </li>
          <li class="pl-4 flex flex-col border-l-2 border-lightSecAccent">
            Years buying homes<span class="text-3xl">12</span>
          </li>
          <li class="pl-4 flex flex-col border-l-2 border-lightSecAccent">
            Properties acquired<span class="text-3xl">310+</span>
          </li>
          <li class="pl-4 flex flex-col border-l-2 border-lightSecAccent">
            Homeowners helped<span class="text-3xl">425+</span>
          </li>
        </ul>
      </div>
    </div>