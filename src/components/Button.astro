---
interface Props {
  as?: "button" | "a";
  hasArrow?: boolean;
  variant?: "primary" | "secondary" | "accent" | "outline";
  // Allows any other standard HTML attributes to pass through
  [key: string]: any; 
}

const {
  as: Tag = "button",
  hasArrow = false,
  variant = "primary",
  class: className = "",
  ...rest // This captures id, type, href, target, etc.
} = Astro.props;

const baseStyles =
  "justify-self-start group inline-flex items-center justify-center gap-2 rounded-full px-8 py-4 text-base font-bold transition-all duration-200 hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-2 hover:cursor-pointer w-full md:w-min text-nowrap";

const variantStyles: Record<string, string> = {
  primary:
    "bg-[#243545] text-white hover:bg-slate-700 focus-visible:outline-[#243545] shadow-sm",
  secondary:
    "bg-white text-slate-900 border border-slate-200 hover:bg-slate-50 hover:border-slate-300 focus-visible:outline-white shadow-sm",
  accent:
    "bg-green-600 text-white hover:bg-green-500 focus-visible:outline-green-600 shadow-sm",
  outline:
    "border-2 border-[#243545] text-[#243545] hover:bg-[#243545] hover:text-white focus-visible:outline-[#243545]",
};
---

<Tag
  class:list={[baseStyles, variantStyles[variant], className]}
  {...rest}
>
  <slot>Get Offer</slot>

  {
    hasArrow && (
      <svg
        class="transition-transform duration-200 group-hover:translate-x-1"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    )
  }
</Tag>