---
import Button from "@/components/Button.astro";
---

<div class="w-full shadow-[0_10px_30px_-5px_rgba(0,0,0,0.08)] ">
  <form id="heroAddressForm" class="relative group" novalidate>
    <!-- Card Container -->
    <div
      class="relative flex items-center bg-white p-1.5 pl-3 rounded-2xl shadow-lg shadow-slate-900/5 border-2 border-slate-300/80 transition-all duration-200 focus-within:border-accent focus-within:ring-2 focus-within:ring-accent/20 "
    >
      <!-- Pin Icon -->
      <div class="text-slate-400 flex items-center pointer-events-none mr-2 flex-shrink-0">
        <svg class=" stroke-lightSecAccent w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="3" stroke-width="2" />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          />
        </svg>
      </div>

      <!-- Input Field -->
      <div class="relative flex-1 min-w-0">
        <input
          type="text"
          id="heroAddressInput"
          placeholder="Enter your street address..."
          autocomplete="off"
          spellcheck="false"
          class="w-full py-2.5 pr-8 bg-slate-50/60 focus-within:bg-white text-slate-800 placeholder:text-slate-400 text-sm sm:text-base font-normal focus:outline-none "
        />

        <!-- Loading Spinner -->
        <div id="lookupSpinner" class="hidden absolute right-2 top-1/2 -translate-y-1/2 flex items-center pointer-events-none text-slate-500">
          <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
        </div>
      </div>

      <!-- Compact Button -->
      <div class="flex-shrink-0 ml-1">
        <Button
          type="submit"
          variant="accent"
          hasArrow={true}
          class="!px-4 !py-2.5 !text-sm !font-semibold !rounded-xl !w-auto shadow-md shadow-emerald-700/20 hover:shadow-lg hover:shadow-emerald-700/30 hover:-translate-y-0.5 transition-all"
        >
          Get Offer
        </Button>
      </div>
    </div>

    <!-- Dropdown List -->
    <ul
      id="suggestionsList"
      class="hidden absolute left-0 right-0 top-full mt-2 bg-white border border-slate-200 rounded-xl shadow-xl z-50 overflow-hidden divide-y divide-slate-100 max-h-60 overflow-y-auto"
      role="listbox"
    ></ul>
  </form>
</div>

<script>
  function setupOSMAutocomplete() {
    const form = document.getElementById("heroAddressForm") as HTMLFormElement;
    const input = document.getElementById("heroAddressInput") as HTMLInputElement;
    const dropdown = document.getElementById("suggestionsList") as HTMLUListElement;
    const spinner = document.getElementById("lookupSpinner") as HTMLElement;

    if (!form || !input || !dropdown) return;

    let debounceTimer: ReturnType<typeof setTimeout>;
    let activeIndex = -1;

    const formatAddressParts = (displayName: string) => {
      const parts = displayName.split(",").map((p) => p.trim());
      const primary = parts.slice(0, 2).join(", ");
      const secondary = parts.slice(2).join(", ");
      return { primary, secondary };
    };

    const closeDropdown = () => {
      dropdown.classList.add("hidden");
      dropdown.innerHTML = "";
      activeIndex = -1;
    };

    input.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      const query = input.value.trim();

      if (query.length < 3) {
        closeDropdown();
        spinner?.classList.add("hidden");
        return;
      }

      spinner?.classList.remove("hidden");

      debounceTimer = setTimeout(async () => {
        try {
          const params = new URLSearchParams({
            format: "json",
            countrycodes: "us",
            addressdetails: "1",
            limit: "5",
            q: query,
          });

          const response = await fetch(`https://nominatim.openstreetmap.org/search?${params.toString()}`);
          const results = await response.json();

          dropdown.innerHTML = "";
          activeIndex = -1;

          if (!results || results.length === 0) {
            closeDropdown();
            return;
          }

          results.forEach((item: any) => {
            const { primary, secondary } = formatAddressParts(item.display_name);

            const li = document.createElement("li");
            li.setAttribute("role", "option");
            li.className = "flex items-start gap-2.5 px-3 py-2 cursor-pointer hover:bg-slate-50 transition-colors";
            li.innerHTML = `
              <div class="flex-1 min-w-0">
                <p class="text-xs sm:text-sm font-semibold text-slate-800 truncate">${primary}</p>
                <p class="text-[11px] text-slate-500 truncate">${secondary}</p>
              </div>
            `;

            li.addEventListener("click", () => {
              input.value = item.display_name;
              
              // Extract parts directly from OpenStreetMap's address object
              const addr = item.address || {};
              const houseNumber = addr.house_number || "";
              const road = addr.road || addr.street || "";
              const street = [houseNumber, road].filter(Boolean).join(" ");
              const city = addr.city || addr.town || addr.village || addr.municipality || "";
              const state = addr.state || "";
              const zip = addr.postcode || "";

              // Save the broken-down parts into sessionStorage
              sessionStorage.setItem("lead_property_address", item.display_name);
              sessionStorage.setItem("lead_property_street", street);
              sessionStorage.setItem("lead_property_city", city);
              sessionStorage.setItem("lead_property_state", state);
              sessionStorage.setItem("lead_property_zip", zip);

              closeDropdown();
              input.focus();
            });

            dropdown.appendChild(li);
          });

          dropdown.classList.remove("hidden");
        } catch (error) {
          closeDropdown();
        } finally {
          spinner?.classList.add("hidden");
        }
      }, 300);
    });

    // Keyboard support
    input.addEventListener("keydown", (e) => {
      const items = dropdown.querySelectorAll("li");
      if (!items.length || dropdown.classList.contains("hidden")) return;

      if (e.key === "ArrowDown") {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % items.length;
        updateSelection(items);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        updateSelection(items);
      } else if (e.key === "Enter" && activeIndex > -1) {
        e.preventDefault();
        (items[activeIndex] as HTMLElement).click();
      } else if (e.key === "Escape") {
        closeDropdown();
      }
    });

    function updateSelection(items: NodeListOf<HTMLLIElement>) {
      items.forEach((item, idx) => {
        if (idx === activeIndex) {
          item.classList.add("bg-slate-100");
          const primaryText = item.querySelector("p")?.textContent;
          if (primaryText) input.value = primaryText;
        } else {
          item.classList.remove("bg-slate-100");
        }
      });
    }

    document.addEventListener("click", (e) => {
      if (!form.contains(e.target as Node)) {
        closeDropdown();
      }
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const address = input.value.trim();
      if (!address) {
        input.focus();
        return;
      }
      
      // Only set full address here; Step 2's regex will handle parsing if they typed manually
      if (!sessionStorage.getItem("lead_property_address") || sessionStorage.getItem("lead_property_address") !== address) {
        sessionStorage.setItem("lead_property_address", address);
      }
      
      window.location.href = "/step-2";
    });
  }

  setupOSMAutocomplete();
  document.addEventListener("astro:page-load", setupOSMAutocomplete);
</script>