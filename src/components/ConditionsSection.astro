---
import ImgCard from "./ImgCard.astro";
---

<p class="eyebrow text-center">Properties We Review</p>
<h2 class="h2 text-center">Every condition, every situation</h2>
<p class="text-center">
  Updated homes, houses that need real work, and occupied rentals all get the
  same review. Nothing has to be cleaned out or repaired before you send the
  address.
</p>

<ul class="grid md:grid-cols-2 lg:grid-cols-4 feature gap-6">
  <li>
    <ImgCard
      ><img class="w-full" src="https://picsum.photos/300/200" alt="" />
      <div class="px-8 py-4">
        <h3 class="font-bold text-lg">Move-in ready</h3>
        <p class="text-sm">Ohio single-family, seller chose the closing date</p>
      </div>
    </ImgCard>
  </li>
  <li>
    <ImgCard
      ><img class="w-full" src="https://picsum.photos/300/200" alt="" />
      <div class="px-8 py-4">
        <h3 class="font-bold text-lg">Needed major work</h3>
        <p class="text-sm">Reviewed as it sits — roof and yard included</p>
      </div>
    </ImgCard>
  </li>
  <li>
    <ImgCard
      ><img class="w-full" src="https://picsum.photos/300/200" alt="" />
      <div class="px-8 py-4">
        <h3 class="font-bold text-lg">Straightforward paperwork</h3>
        <p class="text-sm">Closings handled by a licensed title company</p>
      </div>
    </ImgCard>
  </li>
  <li>
    <ImgCard
      ><img class="w-full" src="https://picsum.photos/300/200" alt="" />
      <div class="px-8 py-4">
        <h3 class="font-bold text-lg">Occupied rental</h3>
        <p class="text-sm">
          Existing lease honored, no tenant removal required
        </p>
      </div>
    </ImgCard>
  </li>
</ul>
