---
const { page } = Astro.props;
---

<div class="after:rounded-xl">
  <div class="info-column w-fit">
    <form
      id={`contact-form`}
      name={`contact-form`}
      class="z-10 py-4 px-4 bg-white text-black max-w-[800px]"
      method="POST"
      action="?"
    >
      <div class="inputWrapper">
        <input required id="street" name="street" type="text" placeholder="" />
        <label class="formLabel relative" for="street">Street:</label>
      </div>
      <div class="form-row grid grid-cols-[2fr_1fr_1fr]">
        <div class="inputWrapper">
          <input required id="city" name="city" type="text" placeholder="" />
          <label class="formLabel relative" for="city">City:</label>
        </div>
        <div class="inputWrapper">
          <input required id="state" name="state" type="text" placeholder="" />
          <label class="formLabel relative" for="state">State:</label>
        </div>
        <div class="inputWrapper">
          <input required id="zip" name="zip" type="number" placeholder="" />
          <label class="formLabel relative" for="zip">Zip:</label>
        </div>
      </div>

      <div class="inputWrapper">
        <input
          required
          id="phone"
          name="phone"
          type="tel"
          placeholder=""
          pattern="([+()\s\-]*[0-9]){10,}[+()\s\-]*"
          title="Please enter a valid phone number with at least 10 digits. (e.g., (555) 123-4567)"
        />
        <label class="formLabel relative" for="phone"> Phone: </label>
      </div>

      <div class="inputWrapper">
        <input required id="email" name="email" type="email" placeholder="" />
        <label class="formLabel relative" for="email"> Email: </label>
      </div>

      <!-- UTM -->
      <input type="hidden" name="utm_campaign" value="" />
      <input type="hidden" name="utm_agid" value="" />
      <input type="hidden" name="utm_term" value="" />
      <input type="hidden" name="utm_content" value="" />
      <input type="hidden" id="gclid_field" name="gclid_field" value="">



      <div
        aria-hidden="true"
        style="opacity: 0; position: absolute; top: 0; left: 0; height: 0; width: 0; z-index: -1;"
      >
        <label for="alt_phone">Alternate Phone (Leave blank)</label>
        <input
          type="text"
          name="alt_phone"
          id="alt_phone"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div
        class="inputWrapper flex flex-col md:flex-row gap-4 align-content-start pt-4"
      >
        <input
          required
          id="chk"
          name="chk"
          type="checkbox"
          placeholder=""
          class="max-w-fit md:ml-2 mb-auto"
        />
        <label class="relative inline-label text-base md:mt-1" for="chk">
          By checking this box you give consent to receive communication from JL
          Home Sale LLC via email, phone, sms. We do not share your details with
          any third parties. By providing your information, you acknowledge and
          agree to our <a class="underline hover:text-accent" href="/privacy/"
            >Privacy Policy</a
          >
          and <a class="underline hover:text-accent" href="/terms/"
            >Terms and Conditions</a
          >. Please note that consent to receive messages is not a condition of
          purchase. Message frequency varies. Standard message and data rates
          may apply. You can opt-out at any time by replying with the keyword
          “STOP”. For additional assistance or information contact us at <a
            class="underline hover:text-accent"
            href="tel:8666986169">(866)698-6169</a
          >
          or send text with keyword “HELP"
        </label>
      </div>

      <div
        class="g-recaptcha mt-8"
        data-sitekey="6Lc3xSgrAAAAAH2prItylKmJkQh1vvVJ3N_J_JXL"
      >
      </div>

      <button
        id="form-submit"
        type="submit"
        class="mt-8 btn btn-primary"
        value="Submit"
      >
        Get Your Offer Now
      </button>
    </form>
    <style>
      /* Your styles remain unchanged */
    </style>
  </div>
</div>


<script>
  // START TIMER: Record the exact time the script loads for bot protection
  const formLoadTime = Date.now();
  
  async function postFormDataAsJson({ url, formData }) {
    const plainFormData = Object.fromEntries(formData.entries());
    
    if (plainFormData.phone) {
      // This strips out all characters except numbers for Zapier
      plainFormData.phone = plainFormData.phone.replace(/\D/g, '');
    }

    const formDataJsonString = JSON.stringify(plainFormData);

    const fetchOptions = {
      method: "POST",
      body: formDataJsonString,
    };

    const response = await fetch(url, fetchOptions);

    if (!response.ok) {
      const errorMessage = await response.text();
      throw new Error(errorMessage);
    }
    
    return response.json();
  }

  async function handleFormSubmit(event) {
    event.preventDefault(); 
    
    const form = document.getElementById("contact-form");
    
    // --- MANUAL PHONE VALIDATION (SMOOTH NATIVE TOOLTIP) ---
    const phoneInput = form.querySelector('input[name="phone"]');
    const rawDigits = phoneInput.value.replace(/\D/g, '');
    
    // If they typed something, but it's less than 10 digits
    if (rawDigits.length > 0 && rawDigits.length < 10) {
      phoneInput.setCustomValidity("Please enter at least 10 digits.");
    } else {
      phoneInput.setCustomValidity("");
    }

    // --- HTML VALIDATION ---
    if (!form.checkValidity()) {
      form.reportValidity(); 
      return; 
    }

    const url = "https://hooks.zapier.com/hooks/catch/9846372/36il180/";
    const formData = new FormData(form);

    // --- ANTI-BOT CHECK 1: Honeypot ---
    if (formData.get("alt_phone")) {
      console.warn("Bot detected: Honeypot filled.");
      form.innerHTML = "<div class='p-4 text-green-600 font-bold text-center text-lg'>Thank you! Your offer request has been received.</div>";
      return; 
    }

    // --- ANTI-BOT CHECK 2: Time-to-Submit ---
    const submitTime = Date.now();
    if (submitTime - formLoadTime < 3000) {
      console.warn("Bot detected: Form submitted too fast.");
      form.innerHTML = "<div class='p-4 text-green-600 font-bold text-center text-lg'>Thank you! Your offer request has been received.</div>";
      return;
    }

    // --- RECAPTCHA CHECK ---
    const captchaResponse = grecaptcha.getResponse();
    if (captchaResponse.length === 0) {
      alert("Please check the 'I am not a robot' box before submitting.");
      return; 
    }

    // --- REAL SUBMISSION ---
    try {
      const responseData = await postFormDataAsJson({ url, formData });
      storeData(formData);
      window.location.assign("/step-2");
    } catch (error) {
      console.error("Submission error: ", error);
      alert("There was an error submitting the form. Please try again.");
    }
  }

  // Safely attach to the specific form ID
  const contactForm = document.getElementById("contact-form");
  if (contactForm) {
    contactForm.addEventListener("submit", handleFormSubmit);

    // --- CLEAR ERROR ON TYPING ---
    // If the phone field was flagged as invalid, clear the flag the moment they start fixing it
    const phoneInput = contactForm.querySelector('input[name="phone"]');
    if (phoneInput) {
      phoneInput.addEventListener('input', () => {
        phoneInput.setCustomValidity(""); 
      });
    }
  }

  // move info to session storage
  function storeData(data){
    for (var p of data) {
      let name = p[0];
      let value = p[1];
      sessionStorage.setItem(name, value);
    }
  }
</script>

<!-- Recaptcha -->
<script is:inline src="https://www.google.com/recaptcha/api.js" async defer
></script>
