---
import { NAV_LINKS, SITE } from "@/siteConfig.ts";
import "@/styles/global.css";
import Button from "@/components/Button.astro";
---

<header
  class="page-layout items-center justify-between p-3 pb-8 sm:p-6 bg-accent sticky top-0 z-100"
>
  <div class="flex items-center justify-between">
    <a
      href="/"
      class="font-sans text-lg font-semibold text-white sm:text-2xl bg-accent tracking-wide"
      ><span class="font-extralight">JL</span><span class="font-semibold">
        Home Sale</span
      ></a
    >
    <nav>
      <ul
        class="flex list-none items-center gap-2 p-0 sm:gap-4 text-white font-bold place-items-center"
      >
        <li class="max-h-min self-center">
         <a href="tel:+18666986169">(866) 698-6169</a>
        </li>
        <li><Button variant="accent" href="/sell">Sell Your House</Button></li>
      </ul>
    </nav>
  </div>
</header>
